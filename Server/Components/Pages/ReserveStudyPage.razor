@page "/reserve-study"
@using System.Text
@using Common.Interfaces
@using Server.Components.SubComponents
@rendermode InteractiveServer
@* Dependency Injection - RS does the reserve study calculations, JS is for file import/export *@
@inject IReserveStudyService RS
@inject IJSRuntime JS

@* Title of the tab in browser *@
<PageTitle>Reserve Study</PageTitle>

<h2 class="text-center">Reserve Study</h2>

@* The study horizon and number of units are now displayed by a component. study is passed as a parameter, event callback calls HandleValidSubmitUnits *@
<ReserveStudyFilters Study="@study" OnValidSubmit="HandleValidSubmitUnits" />

@* The component list is now displayed by a (blazor) component. study is passed in as a paramert, event callbacks call ConfirmDelete and AddComponent *@
<ReserveItemList Study="@study" OnDeleteComponent="ConfirmDelete" OnAddComponent="AddComponent" />

@* Contains forms and a chart depending on certain conditions *@
<div class="container text-center col-md-6">
    @* If the user is adding a component, displays a form tied to the newComponent object, with input fields for each property *@
    @if (addNewComponent)
    {
        @* The new component form is now its own (blazor) component. It takes newComponent as a parameter and has an event callback calling HandleValidSubmitComponent *@
        <ReserveItemDialog newComponent="@newComponent" OnValidSubmit="HandleValidSubmitComponent" />
    }

    @* The annual expenses chart is now its own component. It takes study as a parameter. *@
    <YearlyTotalsChart Study="@study"/>

    @* Button to export the current component list to a .csv file *@
    <button class="btn btn-primary" @onclick="ExportToCSV">Export to .csv File</button> <br /> <br />
    @* Button to import a .csv file to populate the component list. Class tags are manipulated to make it look like a normal button *@
    <label class="btn btn-primary position-relative" for="csvImport">
        Import .csv File
        <InputFile OnChange="ImportComponents" accept=".csv" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" />
    </label>
</div>

@code {
    // Model objects to store data
    private ReserveStudy study = new();
    private RSComponent newComponent = new();
    // Boolean to track state
    private bool addNewComponent = false;
    // Called when add component is clicked - boolean is flipped
    private void AddComponent()
    {
        addNewComponent = true;
    }
    // Called via event callback, deletes a component from the component list
    private void ConfirmDelete(RSComponent component)
    {
        study.Components.Remove(component);
    }
    // Called via event callback, adds a new component, then resets model and bool
    private void HandleValidSubmitComponent()
    {
        study.Components.Add(newComponent);
        newComponent = new();
        addNewComponent = false;
    }
    // Called via event callback. Does nothing but trigger a render so the page values update when number of units is changed
    private void HandleValidSubmitUnits()
    {
    }    
    // Called when the user clicks import .csv file - this function was provided by ChatGPT, although the comments are my own
    private async Task ImportComponents(InputFileChangeEventArgs e)
    {
        // e.File represents the file selected in the file import
        var file = e.File;
        // Opens the file and provides a stream of the contents (max size 1000000 bytes)
        using var stream = file.OpenReadStream(1000000);
        // Reads the stream with the file contents
        using var reader = new StreamReader(stream);
        // Creating a string to store lines and a boolean to check if it's the first line
        string? line;
        bool firstLine = true;
        // Resetting the components list so the file represents its own study and doesn't simply add to the existing list
        study.Components = new();

        // While the next line is not null...
        while ((line = await reader.ReadLineAsync()) != null)
        {
            // If it's the first line, skip it (first line contains a header)
            if (firstLine)
            {
                firstLine = false;
                continue;
            }
            // Breaking the line up into its three segments
            string[] fields = line.Split(',');
            // If the line was three items long, and each line parses into the expected variable type, a new component is created and added to the list
            if (fields.Length == 3 && int.TryParse(fields[1], out int usefulLife) && decimal.TryParse(fields[2],
            out decimal replacementCost))
            {
                RSComponent component = new()
                {
                    Name = fields[0],
                    UsefulLife = usefulLife,
                    ReplacementCost = replacementCost
                };
                study.Components.Add(component);
            }
        }
    }
    // Called when the user clicks export to .csv
    private async Task ExportToCSV()
    {
        // Creating a stringbuilder to store the values being exported
        StringBuilder csv = new();
        // Creating the header line
        csv.AppendLine("Name,UsefulLife,ReplacementCost");
        // Adding a line for each component
        foreach (RSComponent component in study.Components)
        {
            csv.AppendLine($"{component.Name},{component.UsefulLife},{component.ReplacementCost}");
        }
        // Creating a filename from the datestamp
        string fileName = $"{DateTime.Now}.csv";
        // Calling the javascript function downloadCsv, which was provided by ChatGPT
        await JS.InvokeVoidAsync("downloadCsv", fileName, csv.ToString());
    }
}