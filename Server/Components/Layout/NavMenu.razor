@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Engulf & Devour</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
@* The NavLinks are the only changes I made on this component - There is a link for each page *@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="future-value">
                <span class="bi bi-calculator-fill" aria-hidden="true"></span> Future Value Calculator
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="balance-sheet">
                <span class="bi bi-calculator-fill" aria-hidden="true"></span> Balance Sheet
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reserve-study">
                <span class="bi bi-buildings" aria-hidden="true"></span> Reserve Study
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

